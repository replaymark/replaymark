{
  "name": "replaymark",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/replaymark/replaymark.git"
  },
  "homepage": "https://github.com/replaymark/replaymark#readme",
  "bugs": {
    "url": "https://github.com/replaymark/replaymark/issues"
  },
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "pnpm -r test",
    "screenshots": "node scripts/screenshots/run.mjs",
    "db:generate": "pnpm --filter @replaymark/server db:generate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "playwright": "^1.63.0",
    "typescript": "7.0.2"
  }
}
