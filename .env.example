# Replaymark configuration. Copy to .env and fill in. Empty values count as unset.

# --- Twitch -----------------------------------------------------------------
# App credentials from https://dev.twitch.tv/console/apps (required)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# EventSub webhook signing secret, 10-100 random characters (required)
# e.g.: openssl rand -hex 32
TWITCH_WEBHOOK_SECRET=
# Public HTTPS URL Twitch posts EventSub notifications to (required)
TWITCH_CALLBACK_URL=https://twitch.example.com/webhook

# --- SMTP -------------------------------------------------------------------
# Mail server (required)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
# Optional; auth is only used when SMTP_USERNAME is set
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender address (required)
SMTP_FROM="replaymark <notify@example.com>"

# --- Admin UI ---------------------------------------------------------------
# Optional, only for the one-time takeover when upgrading from a version with a single
# admin password: the hash becomes the password of the account `admin`. Remove it
# afterwards. A fresh install needs no password here: the setup code is in `docker logs`.
# Keep the single quotes: the hash contains `$`, which Docker Compose would otherwise
# interpolate. Example: ADMIN_PASSWORD_HASH='scrypt$32768$8$1$<salt>$<hash>'
ADMIN_PASSWORD_HASH=
# Set to false when the admin UI is accessed via plain http in the LAN (default: true)
ADMIN_COOKIE_SECURE=true
# Optional; adds a link to the admin UI in mails
PUBLIC_BASE_URL=

# --- Runtime ----------------------------------------------------------------
# Data directory for the SQLite database (default: /data)
DATA_DIR=/data
# Time zone used for timestamps in mails
TZ=Europe/Berlin
# debug | info | warn | error (default: info)
LOG_LEVEL=info

# --- Development overrides (optional) ---------------------------------------
# Listener ports (defaults: 8080 webhook, 8081 admin, 8082 internal on 127.0.0.1)
PUBLIC_PORT=
ADMIN_PORT=
INTERNAL_PORT=
# Directory of the built admin SPA (default: ../web/dist relative to apps/server)
WEB_DIST=

# --- Docker Compose ---------------------------------------------------------
# Host address the admin port 8081 is published on: LAN IP, 127.0.0.1 or a
# Tailscale address. Never a public interface. (default: 127.0.0.1)
ADMIN_BIND=
